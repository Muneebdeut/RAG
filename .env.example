# ─────────────────────────────────────────────────────────────────────────────
# AetherRAG — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your values.
# The ".env" file is gitignored and never committed.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your real keys
# ─────────────────────────────────────────────────────────────────────────────

# Disable ChromaDB telemetry (prevents slow startup on restricted networks)
ANONYMIZED_TELEMETRY=False

# Google Gemini API Key (get one free at https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (get one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: Override log level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
